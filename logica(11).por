programa {
  funcao inicio() {
    inteiro ferraduras
    inteiro cavalos
    inteiro resultado
    escreva("digite  quantas ferraduras \n")
    leia(ferraduras)
    escreva(" digite qunatos  cavalos são\n")
     leia(cavalos)
    resultado = (ferraduras)*(cavalos * 4)
     escreva("o  resultado é :" , resultado)


  }
}
