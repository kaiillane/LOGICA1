programa {
  funcao inicio() {
     inteiro numero1
     inteiro numero2
     inteiro resultado
     escreva ("digite o primero numero")
     leia(numero1)
     escreva("digite o segundo numero")
     leia(numero2)
     resultado=(numero1 % numero2) 
     escreva("o resultado é:",resultado)
    
  

  }
}
